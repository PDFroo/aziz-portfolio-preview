{
  "name": "abdul-aziz-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist --d1 DB=abdul_aziz_portfolio",
    "db:init": "wrangler d1 execute abdul_aziz_portfolio --local --file=./db/schema.sql",
    "build:gh": "BASE=/aziz-portfolio-preview/ VITE_STATIC=1 vite build && cp dist/index.html dist/404.html && rm -f dist/_redirects",
    "deploy": "npm run build:gh && gh-pages -d dist -b gh-pages --dotfiles"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wrangler": "^4.34.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "playwright": "^1.56.0"
  }
}